# Environment Configuration for MCP Inspector

# Node.js Environment
NODE_ENV=development
NODE_TLS_REJECT_UNAUTHORIZED=0
DEBUG=1

# Port Configuration
# Main application port (health check + UI + proxy all on this port)
PORT=8080

# MCP Inspector server port (internal communication)
SERVER_PORT=6277

# Allowed origins for CORS (include your main port)
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:6274

# Auto-open browser (set to false in production/pods)
MCP_AUTO_OPEN_ENABLED=false

# Disable authentication (set to true to disable auth token requirement)
# WARNING: Only use in trusted environments
DANGEROUSLY_OMIT_AUTH=true

# Optional: MCP Server Configuration
# If you need to connect to a specific MCP server on startup
# MCP_TRANSPORT=stdio
# MCP_SERVER_URL=
